
StateInspector {
  width: 100%;
  height: 1fr;
  border: double $pl_border;
  background: $pl_bg;
  padding: 1 1 0 1;
  StateTree {
    width: 1fr;
    height: 1fr;
    background: $pl_bg;
    color: $pl_text;
    padding: 0 1;
    border: round $pl_border;
    border-title-color: $pl_muted;
  }
}

AppHeader {
  border: double $pl_border;
  background: $pl_panel;
  height: 4;
  padding: 0 1;
  border-title-align: right;
  border-title-color: $pl_gold;
  border-title-style: bold;
}

#header-meta {
  grid-size: 2 2;
  grid-columns: 11 1fr;
  grid-rows: 1 1;
  height: 2;
}

.header-key {
  color: $pl_muted;
}

#header-project {
  width: 1fr;
  text-style: bold;
}

#header-stack {
  color: $pl_accent;
}

ModalScreen {
  align: center middle;
  #stacks {
    width: 50%;
    border: double $pl_border;
    background: $pl_panel;
  }
}

#resource-details {
  width: 95%;
  height: 95%;
  border: double $pl_border;
  background: $pl_panel;
  padding: 0 1;
}

#resource-details-label {
  height: 1;
  text-style: bold;
  margin-bottom: 1;
}

#resource-summary {
  grid-size: 2;
  grid-columns: 20 1fr;
  grid-rows: auto;
  grid-gutter: 0 1;
  display: none;
  padding: 0 1;
  border: round $pl_border;
  background: $pl_surface;
  height: 1fr;
  overflow-y: auto;
}

.summary-key {
  text-style: bold;
  color: $pl_accent_soft;
}

.summary-value {
  color: $pl_text;
}

#resource-view-tabs {
  height: 2;
  background: $pl_panel;
}

#resource-payload {
  height: 1fr;
  border: round $pl_border;
  background: $pl_bg;
  color: $pl_text;
}

#state-filters {
  height: 3;
  background: $pl_bg;
  margin-bottom: 1;
}

#state-tree-container {
  height: 1fr;
  background: $pl_bg;
}

#state-search {
  width: 1fr;
  background: $pl_surface;
  border: round $pl_border;
  color: $pl_text;
  height: 3;
}

#state-search:focus {
  border: round $pl_accent;
}

#state-type-filter {
  width: 100%;
  height: 3;
  background: $pl_panel;
}

#state-type-filter > SelectCurrent {
  border: round $pl_border;
  background: $pl_surface;
  color: $pl_text;
  padding: 0 1;
}

#state-type-filter:focus > SelectCurrent {
  border: round $pl_accent;
}

#state-type-filter > SelectOverlay {
  border: round $pl_accent;
  background: $pl_surface;
  color: $pl_text;
  padding: 0 1;
}

#toggle-filters {
  width: auto;
  min-width: 14;
  height: 3;
  margin-left: 1;
  padding: 0 1;
  background: $pl_surface;
  border: round $pl_border;
}

#toggle-filters:focus {
  border: round $pl_accent;
}

#toggle-filters:hover {
  background: $pl_border;
}

#state-filter-panel {
  display: none;
  height: auto;
  padding: 1;
  margin-bottom: 1;
  border: round $pl_border;
  background: $pl_panel;
}

#state-filter-panel.-expanded {
  display: block;
}

#state-type-label {
  height: 1;
  width: 100%;
  background: $pl_panel;
  color: $pl_muted;
  margin-bottom: 1;
}

#switcher {
  border: double lightblue;
  border_title_align: center;
}

#tree {
  background: $pl_bg;
  color: $pl_text;
}


Screen {
  background: $pl_bg;
  color: $pl_text;
  overflow-y: hidden;
}


Button {
  width: 100%;
  border: round $pl_border;
  background: $pl_surface;
  color: $pl_text;
}

Button:hover {
  background: $pl_border;
}

Button.-primary {
  background: $pl_accent;
  color: $pl_bg;
}


#stacks-list {
  grid-gutter: 1 2;
  height: 8;
  margin-bottom: 1;
}


#workspaces {
  grid-size: 2;
  padding: 1 2;
  width: 30%;
  max-height: 18;
  border: thick $background 80%;
  background: $pl_surface;
}
