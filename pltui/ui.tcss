
StateInspector {
  width: 100%;
  height: 1fr;
  border: double $border;
  background: $background;
  padding: 1 1 0 1;
  StateTree {
    width: 1fr;
    height: 1fr;
    background: $background;
    color: $foreground;
    padding: 0 1;
    border: round $border;
    border-title-color: $secondary;
  }
}

AppHeader {
  border: double $border;
  background: $panel;
  height: 4;
  padding: 0 1;
  border-title-align: right;
  border-title-color: $warning;
  border-title-style: bold;
}

#header-meta {
  grid-size: 2 2;
  grid-columns: 11 1fr;
  grid-rows: 1 1;
  height: 2;
}

.header-key {
  color: $text-muted;
}

#header-project {
  width: 1fr;
  text-style: bold;
}

#header-stack {
  height: 1;
  width: auto;
  max-width: 100%;
  background: $panel;
  color: $secondary;
}

#header-stack > SelectCurrent {
  width: auto;
  max-width: 100%;
  height: 1;
  background: $panel;
  color: $secondary;
}

#header-stack > SelectCurrent > #label {
  width: auto;
}

#header-stack > SelectOverlay {
  border: round $accent;
  background: $surface;
}

ModalScreen {
  align: center middle;
}

#resource-details {
  width: 95%;
  height: 95%;
  border: double $border;
  background: $panel;
  padding: 0 1;
}

#resource-details-label {
  height: 1;
  text-style: bold;
  margin-bottom: 1;
}

#resource-summary {
  grid-size: 2;
  grid-columns: 20 1fr;
  grid-rows: auto;
  grid-gutter: 0 1;
  display: none;
  padding: 0 1;
  border: round $border;
  background: $surface;
  height: 1fr;
  overflow-y: auto;
}

.summary-key {
  text-style: bold;
  color: $secondary;
}

.summary-value {
  color: $foreground;
}

#resource-view-tabs {
  height: 2;
  background: $panel;
}

#resource-payload {
  height: 1fr;
  border: round $border;
  background: $background;
  color: $foreground;
}

#confirm-dialog {
  width: 70;
  height: auto;
  max-height: 90%;
  border: double $border;
  background: $panel;
  padding: 1 2;
}

#confirm-title {
  text-style: bold;
  margin-bottom: 1;
}

#confirm-message-scroll {
  height: auto;
  max-height: 20;
  margin-bottom: 1;
}

#confirm-message {
  height: auto;
}

#confirm-actions {
  height: 3;
  align-horizontal: right;
}

#confirm-actions Button {
  width: auto;
  margin-left: 1;
}

#confirm-actions Button.-error {
  background: $error;
  color: $background;
}

#action-run {
  width: 95%;
  height: 95%;
  border: double $border;
  border-title-color: $warning;
  border-title-style: bold;
  background: $panel;
  padding: 0 1;
}

#action-run-status {
  margin: 1 0;
  padding-left: 1;
}

#action-run-status.-error {
  color: $error;
}

#action-run-log {
  height: 1fr;
  border: round $border;
  background: $background;
  color: $foreground;
}

#action-run-buttons {
  dock: bottom;
  height: 3;
  align-horizontal: right;
}

#action-run-buttons Button {
  width: auto;
  margin-left: 1;
}

#action-apply {
  background: $error;
  color: $background;
}

#state-filters {
  height: 3;
  background: $background;
  margin-bottom: 1;
}

#state-tree-container {
  height: 1fr;
  background: $background;
}

#resource-selection-actions {
  width: auto;
  height: 3;
  background: $background;
}

#deselect-matching {
  display: none;
}

#resource-selection-actions Button {
  width: auto;
  height: 3;
  margin-left: 1;
}

#state-search {
  width: 1fr;
  background: $surface;
  border: round $border;
  color: $foreground;
  height: 3;
}

#state-search:focus {
  border: round $accent;
}

#state-type-filter {
  width: 34;
  height: 3;
  margin-left: 1;
  background: $background;
}

#state-protected-filter {
  width: auto;
  height: 3;
  margin-left: 1;
  padding: 0 1;
  border: round $border;
  background: $surface;
}

#state-protected-filter:focus {
  border: round $accent;
}

#state-type-filter > SelectCurrent {
  border: round $border;
  background: $surface;
  color: $foreground;
  padding: 0 1;
}

#state-type-filter:focus > SelectCurrent {
  border: round $accent;
}

#state-type-filter > SelectOverlay {
  border: round $accent;
  background: $surface;
  color: $foreground;
  padding: 0 1;
}

Screen {
  background: $background;
  color: $foreground;
  overflow-y: hidden;
}

Button {
  width: 100%;
  border: round $border;
  background: $surface;
  color: $foreground;
}

Button:hover {
  background: $border;
}

Button:focus {
  text-style: bold;
  border: round $accent;
  background-tint: transparent;
}
