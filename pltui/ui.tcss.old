
StateInspector {
  StateTree {
    width: 1fr;
  }
  VerticalScroll {
    width: 1fr;
    margin: 1 1 1 1;
  }
}

AppHeader {
  border: double lightblue;
  border-title-align: center;
  height: 8;
  layout: horizontal;
}

.header-box {
  margin: 0 0 0 3;
  text-align: left;
}

#titles-box {
  width: 1fr;
}

#logo-box {
  width: auto;
}

ModalScreen {
  align: center middle;
}

#resource {
  margin: 0 0 0 1;
}

#plan {
  background: $surface;
  margin: 0 0 0 1;
}

#commandoutput {
  margin: 0 0 0 1;
}

#search {
  background: $surface;
  border: double lightblue;
  height: 3;
}

#switcher {
  border: double lightblue;
  border_title_align: center;
}

#tree {
  background: $surface;
}


Screen {
  color: $text;
  overflow-y: hidden;
}


Button {
  width: 100%;
}


OptionList {
  grid-gutter: 1 2;
  height: 8;
  margin-bottom: 1;
}


#workspaces {
  grid-size: 2;
  padding: 1 2;
  width: 30%;
  max-height: 18;
  border: thick $background 80%;
  background: $surface;
}